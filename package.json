{
  "name": "torchat",
  "version": "0.3.0",
  "private": true,
  "description": "Peer-to-peer chat over Tor onion services. No accounts, no servers you can name, and no IP address of yours is ever published.",
  "keywords": [
    "p2p",
    "peer-to-peer",
    "tor",
    "onion-service",
    "anonymous",
    "chat",
    "privacy",
    "electron",
    "end-to-end-encryption"
  ],
  "homepage": "https://github.com/VijayarajParamasivam/TorChat#readme",
  "bugs": {
    "url": "https://github.com/VijayarajParamasivam/TorChat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VijayarajParamasivam/TorChat.git"
  },
  "license": "MIT",
  "author": "Vijayaraj Paramasivam",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "start:b": "node scripts/second-instance.js",
    "test": "node test/crypto-and-transport.js && node test/tor.js && node test/regressions.js && node test/ui.js",
    "postinstall": "node scripts/get-tor.js",
    "get-tor": "node scripts/get-tor.js"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.torchat.torchat",
    "productName": "TorChat",
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "vendor/tor",
        "to": "tor",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
